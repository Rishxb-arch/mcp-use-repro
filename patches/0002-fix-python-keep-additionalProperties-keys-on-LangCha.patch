From 8f7cf58637976def736c252315936b98c692e957 Mon Sep 17 00:00:00 2001
From: Rishxb-arch <270784950+Rishxb-arch@users.noreply.github.com>
Date: Sat, 3 Oct 2026 22:20:56 +0530
Subject: [PATCH 2/2] fix(python): keep additionalProperties keys on LangChain
 tool schemas

The generated args model ignored undeclared keys, so a tool call whose
schema sets additionalProperties dropped those keys before the server saw
them. Allow extras when additionalProperties is true or a schema.

Co-Authored-By: Cursor Agent <cursoragent@cursor.com>
---
 .../agents/adapters/langchain_adapter.py      | 44 ++++++++++++++++++-
 .../tests/unit/test_langchain_adapter.py      | 32 ++++++++++++++
 2 files changed, 74 insertions(+), 2 deletions(-)

diff --git a/libraries/python/mcp_use/agents/adapters/langchain_adapter.py b/libraries/python/mcp_use/agents/adapters/langchain_adapter.py
index 3ef7b82f..c43a97f6 100644
--- a/libraries/python/mcp_use/agents/adapters/langchain_adapter.py
+++ b/libraries/python/mcp_use/agents/adapters/langchain_adapter.py
@@ -24,7 +24,7 @@ from mcp.types import (
 from mcp.types import (
     Tool as MCPTool,
 )
-from pydantic import BaseModel, Field, create_model
+from pydantic import BaseModel, ConfigDict, Field, create_model
 
 from mcp_use.agents.adapters.base import BaseAdapter
 from mcp_use.client.connectors.base import BaseConnector
@@ -35,6 +35,27 @@ LangChainContentBlock = dict[str, Any]
 LangChainToolResult = str | LangChainContentBlock | list[LangChainContentBlock]
 
 
+def _args_schema(schema: dict[str, Any]) -> type[BaseModel]:
+    """Build the tool args model, keeping extra keys when the schema allows them.
+
+    ``jsonschema_to_pydantic`` ignores keys that are not declared as properties.
+    When ``additionalProperties`` is true or a schema, those keys are part of the
+    input and must survive validation.
+
+    Args:
+        schema: Tool input JSON Schema, already normalized by ``fix_schema``.
+
+    Returns:
+        A Pydantic model for ``args_schema``. Extra keys are allowed only when
+        ``additionalProperties`` is true or a schema.
+    """
+    model = jsonschema_to_pydantic(schema)
+    additional = schema.get("additionalProperties") if isinstance(schema, dict) else None
+    if additional is True or isinstance(additional, dict):
+        return create_model(model.__name__, __base__=model, __config__=ConfigDict(extra="allow"))
+    return model
+
+
 def _mcp_content_to_langchain(content: list[Any]) -> str | list[LangChainContentBlock]:
     """Convert MCP tool result content to LangChain-compatible format.
 
@@ -146,7 +167,7 @@ class LangChainAdapter(BaseAdapter[BaseTool]):
             name: str = mcp_tool.name or "NO NAME"
             description: str = mcp_tool.description or ""
             # Convert JSON schema to Pydantic model for argument validation
-            args_schema: type[BaseModel] = jsonschema_to_pydantic(
+            args_schema: type[BaseModel] = _args_schema(
                 adapter_self.fix_schema(mcp_tool.inputSchema)  # Apply schema conversion
             )
             tool_connector: BaseConnector = connector  # Renamed variable to avoid name conflict
@@ -155,6 +176,25 @@ class LangChainAdapter(BaseAdapter[BaseTool]):
             def __repr__(self) -> str:
                 return f"MCP tool: {self.name}: {self.description}"
 
+            def _to_args_and_kwargs(self, tool_input: str | dict, tool_call_id: str | None = None):
+                """Pass undeclared keys through when the schema allows them.
+
+                LangChain skips validation and drops the input when ``args_schema``
+                has no declared fields. That is wrong for a schema whose only
+                constraint is ``additionalProperties``.
+                """
+                schema = self.args_schema
+                allows_extra = (
+                    isinstance(schema, type)
+                    and issubclass(schema, BaseModel)
+                    and schema.model_config.get("extra") == "allow"
+                    and not schema.model_fields
+                )
+                if allows_extra and isinstance(tool_input, dict):
+                    parsed = self._parse_input(tool_input, tool_call_id)
+                    return (), dict(parsed) if isinstance(parsed, dict) else {}
+                return BaseTool._to_args_and_kwargs(self, tool_input, tool_call_id)
+
             def _run(self, **kwargs: Any) -> NoReturn:
                 """Synchronous run method that always raises an error.
 
diff --git a/libraries/python/tests/unit/test_langchain_adapter.py b/libraries/python/tests/unit/test_langchain_adapter.py
index aeecfeb5..648a72c9 100644
--- a/libraries/python/tests/unit/test_langchain_adapter.py
+++ b/libraries/python/tests/unit/test_langchain_adapter.py
@@ -112,3 +112,35 @@ class TestLangChainAdapterToolExecution:
         assert result["details"] == "tool failed"
         assert result["tool"] == "failing_tool"
         assert result["tool_content"] == "tool failed"
+
+    def test_additional_properties_schema_keeps_extra_keys(self):
+        """A schema-valued additionalProperties must pass undeclared keys through."""
+        adapter = LangChainAdapter()
+        tool = Tool(
+            name="additional",
+            description="additional",
+            inputSchema={"type": "object", "additionalProperties": {"type": "integer"}},
+        )
+        langchain_tool = adapter._convert_tool(tool, MagicMock())
+
+        assert langchain_tool is not None
+        assert langchain_tool.args_schema.model_config.get("extra") == "allow"
+        assert langchain_tool._to_args_and_kwargs({"k": 1}, None) == ((), {"k": 1})
+
+    def test_additional_properties_true_keeps_extra_keys(self):
+        """additionalProperties: true must keep keys besides the declared properties."""
+        adapter = LangChainAdapter()
+        tool = Tool(
+            name="open",
+            description="open",
+            inputSchema={
+                "type": "object",
+                "properties": {"a": {"type": "integer"}},
+                "additionalProperties": True,
+            },
+        )
+        langchain_tool = adapter._convert_tool(tool, MagicMock())
+
+        assert langchain_tool is not None
+        assert langchain_tool.args_schema.model_config.get("extra") == "allow"
+        assert langchain_tool._to_args_and_kwargs({"a": 1, "k": 2}, None) == ((), {"a": 1, "k": 2})
